# ── LLM (optional) ─────────────────────────────────────────────
# Any OpenAI-compatible Chat Completions endpoint with tool calling.
# Leave LLM_API_KEY empty to run the companion on the offline rules planner.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
# Optional, for reasoning models (low|medium|high). "low" keeps voice replies fast.
LLM_REASONING_EFFORT=

# ── Reflect API (public, no key needed) ────────────────────────
REFLECT_API_BASE_URL=https://prod.api.reflect.money
REFLECT_DOCS_INDEX_URL=https://docs.reflect.money/llms.txt

# ── MCP transport between the web server and the MCP server ───
# stdio (default): spawn packages/mcp-server as a child process
# inprocess: link in memory (for platforms without child processes)
MCP_TRANSPORT=stdio
# Set to "silent" to hide per-request API logs from the MCP server
REFLECT_MCP_LOG=
