{
  "name": "reflect-companion",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @companion/web dev",
    "build": "pnpm --filter @companion/web build",
    "mcp": "pnpm --filter @companion/mcp-server start",
    "mcp:inspect": "pnpm --filter @companion/mcp-server inspect",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @companion/web e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}